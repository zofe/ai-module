{
    "name": "zofe/ai-module",
    "description": "AI widget, tool registry and multi-provider service (Anthropic, OpenAI-compatible, Ollama) for rapyd-admin",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/zofe/ai-module",
    "authors": [
        {
            "name": "Felice Ostuni",
            "email": "felice.ostuni@uania.com",
            "homepage": "https://rapyd.dev"
        }
    ],
    "keywords": [
        "laravel",
        "livewire",
        "ai",
        "chatbot",
        "rapyd-admin",
        "openai",
        "anthropic",
        "ollama"
    ],
    "autoload": {
        "psr-4": {
            "Zofe\\Ai\\": "./"
        }
    },
    "require": {
        "php": "^8.2",
        "zofe/rapyd-admin": "^9.6"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Zofe\\Ai\\AiServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
